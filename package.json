{
  "name": "ledgerone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "orchestrate": "scripts\\.venv\\Scripts\\python.exe scripts/orchestrate.py",
    "test:e2e": "scripts\\.venv\\Scripts\\python.exe scripts/orchestrate.py test",
    "test:e2e:headed": "scripts\\.venv\\Scripts\\python.exe scripts/orchestrate.py test --headed",
    "test:doctor": "scripts\\.venv\\Scripts\\python.exe scripts/orchestrate.py doctor",
    "test:clean": "scripts\\.venv\\Scripts\\python.exe scripts/orchestrate.py clean",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@aws-sdk/client-s3": "^3.1127.0",
