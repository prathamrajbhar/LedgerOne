# Environment Variables Configuration

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ledgerone?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-characters-long"

# AWS S3 (File Storage)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET_NAME="ledgerone-files"

# Resend (Email)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Anthropic Claude API (Help Assistant Chatbot)
ANTHROPIC_API_KEY="sk-ant-your-api-key"

# Logging
LOGTAIL_SOURCE_TOKEN="your-logtail-token"

# Node Environment
NODE_ENV="development"
