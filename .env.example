# ==============================================================================
# LedgerOne Environment Variables Template
# Copy this file to .env for local development or configure in your deployment dashboard
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# ==============================================================================
# 1. DATABASE (Required)
# ==============================================================================
# PostgreSQL Connection URL (e.g. Supabase, AWS RDS, Neon, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ledgerone?schema=public"

# ==============================================================================
# 2. AUTHENTICATION (Required)
# ==============================================================================
# Base URL for auth callbacks
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cryptographic Secret for Session & JWT Token Encryption (min 32 chars, e.g. openssl rand -hex 32)
AUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"

# ==============================================================================
# 3. FILE STORAGE - AWS S3 / LocalStack (Required for attachments & PDF storage)
# ==============================================================================
# For local development with LocalStack:
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="us-east-1"
AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_S3_BUCKET_NAME="ledgerone-files"

# For production AWS S3:
# AWS_REGION="ap-south-1"
# AWS_DEFAULT_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID="AKIA..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_S3_BUCKET_NAME="your-bucket-name"
# (Omit AWS_ENDPOINT_URL in production)

# ==============================================================================
# 4. EMAIL SERVICE - SMTP / Gmail (Required for invitations & password resets)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="LedgerOne <your-email@gmail.com>"

# ==============================================================================
# 5. PAYMENT GATEWAY - Razorpay (Required for customer invoice settlement)
# ==============================================================================
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ==============================================================================
# 6. AI ASSISTANT & COPILOT - Google Gemini (Required for AI features)
# ==============================================================================
GEMINI_API_KEY="your-google-gemini-api-key"

# ==============================================================================
# 7. LOGGING & MONITORING (Optional)
# ==============================================================================
LOG_LEVEL="debug"
LOG_FORMAT="pretty"
LOGTAIL_SOURCE_TOKEN="your-logtail-source-token"
